        },
        {
          "href": "https://github.com/sasakiuri",
          "label": "GitHub"
        }
      ],
      "title": "梶ヶ谷 宜之 | ホームページ"
    },
    "root": {
      "artifactPath": "index.html",
      "url": "https://slithy.net/",
      "description": "SLITHY.NET explains the meaning of “slithy”—a word with two meanings packed into one.",
      "language": "en",
      "path": "/",
      "socialMetadata": false,
      "title": "SLITHY.NET"
    }
  },
  "version": 1
}
