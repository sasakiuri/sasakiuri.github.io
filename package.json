{
  "name": "sasakiuri.github.io",
  "version": "2.0.0",
  "private": true,
  "description": "梶ヶ谷宜之のホームページ",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/harden-static-export.mjs && node scripts/inject-service-worker-manifest.mjs && node scripts/verify-static-export.mjs --seal",
    "analyze": "next experimental-analyze",
    "preview": "serve out --no-clipboard",
    "clean": "rimraf .next out coverage playwright-report reports storybook-static stryker test-results",
    "contract:validate": "node scripts/validate-site-contract.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "biome lint . --error-on-warnings",
    "lint:fix": "biome lint . --write --error-on-warnings",
    "lint:architecture": "corepack pnpm --filter @sasakiuri/architecture-tools architecture",
    "lint:cycles": "corepack pnpm --filter @sasakiuri/architecture-tools cycles",
    "lint:spell": "cspell lint --no-progress --show-suggestions .",
    "lint:styles": "stylelint \"src/**/*.css\"",
    "lint:styles:fix": "stylelint \"src/**/*.css\" --fix",
    "lint:text": "textlint README.md CONTRIBUTING.md SECURITY.md \"docs/**/*.md\"",
    "typegen": "next typegen",
    "typecheck": "run-s typegen typecheck:compiler",
    "typecheck:compiler": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:artifact": "node scripts/run-playwright-artifact.mjs --project=chromium",
    "test:e2e:all": "playwright test",
    "test:e2e:firefox": "playwright test --project=firefox",
    "test:e2e:update": "playwright test --project=chromium --update-snapshots",
    "test:e2e:webkit": "playwright test --project=webkit",
    "test:lighthouse": "run-s build lighthouse",
    "test:mutation": "node scripts/run-mutation.mjs",
    "test:reproducible": "node scripts/verify-reproducible-build.mjs",
    "test:storybook": "vitest run --config vitest.storybook.config.ts",
    "test:storybook:watch": "vitest --config vitest.storybook.config.ts",
    "storybook": "storybook dev --port 6006 --no-open",
    "storybook:build": "storybook build",
    "lighthouse": "node scripts/run-lighthouse.mjs",
    "monitor:production": "node scripts/monitor-production.mjs",
    "size": "size-limit",
    "size:check": "run-s build size",
    "artifact:seal": "node scripts/verify-static-export.mjs --seal",
    "artifact:verify": "node scripts/verify-static-export.mjs --verify reports/artifact/static-export-manifest.json",
    "license:check": "node scripts/check-licenses.mjs",
    "license:report": "node scripts/check-licenses.mjs --report",
    "deps:check": "knip",
    "deps:audit": "node scripts/audit-dependencies.mjs",
    "diary:import": "node scripts/import-diary-browser-export.mjs",
    "diary:update": "node scripts/update-diary.mjs",
    "check": "run-s format:check lint lint:styles lint:text lint:spell lint:architecture lint:cycles contract:validate typecheck test:coverage deps:check license:check",
    "validate": "run-s check test:storybook build test:e2e:artifact size lighthouse deps:audit artifact:verify",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.10",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@playwright/test": "1.62.1",
    "@size-limit/file": "13.0.3",
    "@storybook/addon-a11y": "10.5.10",
    "@storybook/addon-docs": "10.5.10",
    "@storybook/addon-vitest": "10.5.10",
    "@storybook/nextjs-vite": "10.5.10",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@textlint-ja/textlint-rule-no-synonyms": "1.3.0",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "acorn": "8.18.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "babel-plugin-react-compiler": "1.0.0",
    "cspell": "10.1.0",
    "fast-check": "4.9.0",
    "jsdom": "30.0.1",
    "knip": "6.32.2",
    "license-checker-rseidelsohn": "5.0.1",
    "lighthouse": "13.4.1",
    "lint-staged": "17.3.0",
    "npm-run-all2": "9.0.3",
    "parse5": "8.0.1",
    "prettier": "3.9.6",
    "rimraf": "6.1.3",
    "serve": "14.2.6",
    "simple-git-hooks": "2.13.1",
    "size-limit": "13.0.3",
    "storybook": "10.5.10",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "sudachi-synonyms-dictionary": "19.0.0",
    "textlint": "15.8.0",
    "textlint-rule-ja-no-redundant-expression": "4.0.1",
    "textlint-rule-no-doubled-joshi": "5.1.1",
    "textlint-rule-preset-ja-spacing": "3.0.3",
    "textlint-rule-preset-ja-technical-writing": "12.0.2",
    "textlint-rule-preset-japanese": "10.0.4",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": ">=11.23.0"
  },
  "packageManager": "pnpm@11.23.0+sha512.f00082e5b283a199b74e079da28d155c008fe232f44c8a06ea7ddfa014ecf719fc362f790ecc67b28106ddac2afb24c49a9a079159da560b2ce7d1e98efd11af",
  "volta": {
    "node": "24.16.0"
  },
  "browserslist": {
    "production": [
      "> 0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "simple-git-hooks": {
    "pre-commit": "npx --no-install lint-staged",
    "commit-msg": "npx --no-install commitlint --edit $1"
  }
}
