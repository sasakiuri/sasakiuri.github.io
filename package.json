{
  "name": "sasakiuri.github.io",
  "version": "2.0.0",
  "private": true,
  "description": "梶ヶ谷宜之のホームページ",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "serve out --no-clipboard",
    "clean": "rimraf .next out coverage playwright-report test-results",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "biome lint . --error-on-warnings",
    "lint:fix": "biome lint . --write --error-on-warnings",
    "lint:styles": "stylelint \"src/**/*.css\"",
    "lint:styles:fix": "stylelint \"src/**/*.css\" --fix",
    "typegen": "next typegen",
    "typecheck": "run-s typegen typecheck:compiler",
    "typecheck:compiler": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "deps:check": "knip",
    "check": "run-s format:check lint lint:styles typecheck test:coverage deps:check",
    "validate": "run-s check test:e2e",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.10",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "@vitest/coverage-v8": "4.1.11",
    "babel-plugin-react-compiler": "1.0.0",
    "jsdom": "30.0.1",
    "knip": "6.32.2",
    "lint-staged": "17.3.0",
    "npm-run-all2": "9.0.3",
    "postcss": "8.5.26",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "rimraf": "6.1.3",
    "serve": "14.2.6",
    "simple-git-hooks": "2.13.1",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": ">=11.22.0"
  },
  "packageManager": "pnpm@11.22.0",
  "browserslist": {
    "production": [
      "> 0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "simple-git-hooks": {
    "pre-commit": "npx --no-install lint-staged",
    "commit-msg": "npx --no-install commitlint --edit $1"
  }
}
