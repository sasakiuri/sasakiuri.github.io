{
  "name": "@sasakiuri/architecture-tools",
  "version": "1.0.0",
  "private": true,
  "description": "TypeScript 5 compatibility island for dependency graph tooling",
  "type": "module",
  "scripts": {
    "architecture": "depcruise ../../src --config ../../.dependency-cruiser.cjs",
    "cycles": "madge --circular --extensions ts,tsx --ts-config tsconfig.json ../../src"
  },
  "devDependencies": {
    "dependency-cruiser": "18.2.0",
    "madge": "8.0.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": ">=11.23.0"
  }
}
